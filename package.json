{
  "name": "cineplayer",
  "version": "1.0.0",
  "description": "Cross-platform desktop video player — Electron + Vue 3 + TypeScript",
  "main": "./out/main/index.js",
  "author": "CinePlayer",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "prebuild": "node scripts/copy-binaries.mjs",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "verify:parsers": "esbuild scripts/verify-parsers.ts --bundle --platform=node --format=esm --target=node20 --outfile=.verify/parsers.mjs --log-level=warning && node .verify/parsers.mjs",
    "verify:main": "esbuild scripts/verify-main.ts --bundle --platform=node --format=esm --target=node20 --alias:electron=./scripts/stub-electron.ts --outfile=.verify/main.mjs --log-level=warning && node .verify/main.mjs",
    "verify": "npm run verify:parsers && npm run verify:main",
    "fixtures": "node scripts/make-fixtures.mjs",
    "clean": "node scripts/clean-orphans.mjs",
    "smoke:local": "node scripts/make-fixtures.mjs && node scripts/smoke.mjs",
    "smoke:stream": "node scripts/smoke-stream.mjs",
    "smoke:cache": "node scripts/smoke-cache.mjs",
    "probe:real": "node scripts/probe-real-source.mjs",
    "probe:stream": "node scripts/probe-real-stream.mjs",
    "smoke": "npm run build && npm run smoke:local && npm run smoke:stream && npm run smoke:cache && npm run clean",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-vue": "^5.0.5",
    "dexie": "^4.0.8",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "hls.js": "^1.5.15",
    "pinia": "^2.2.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3",
    "vue-tsc": "^2.0.29"
  }
}
